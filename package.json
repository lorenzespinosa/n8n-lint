{
  "name": "n8n-lint",
  "version": "1.0.0",
  "description": "CLI linter for n8n workflow JSON files — catches credential leaks, deprecated nodes, missing error handling, and best-practice violations",
  "type": "module",
  "main": "src/linter.js",
  "bin": {
    "n8n-lint": "src/cli.js"
  },
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "lint": "node src/cli.js ."
  },
  "keywords": ["n8n", "lint", "workflow", "automation", "validation", "cli"],
  "author": "Lorenz Espinosa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lorenzespinosa/n8n-lint"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": ["src/", "LICENSE", "README.md"],
  "dependencies": {
    "chalk": "^5.3.0"
  }
}
